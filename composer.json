{
    "name": "firevel/webhook-gateway-laravel-client",
    "description": "Webhook Gateway client for Laravel",
    "type": "library",
    "require": {
        "guzzlehttp/guzzle": "^6.3|^7.0",
        "illuminate/support": "~5.5.0|~5.6.0|~5.7.0|~5.8.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Firevel\\WebhookGatewayLaravelClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Firevel\\WebhookGatewayLaravelClient\\Providers\\WebhookGatewayClientServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Michael Slowik"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Firevel\\WebhookGatewayLaravelClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
